@startuml
!include <C4/C4_Container>

title C4 Container — Estado implementado (P0/P1)

Person(customer, "Cliente", "Interage pelo WhatsApp para renegociar débitos ou consultar fatura e limite.")
System_Ext(whatsapp, "WhatsApp Cloud API", "Canal externo e entrega de webhooks.")
System_Ext(openai, "OpenAI", "Chat completion e embeddings.")
System_Ext(coreMock, "Core Bancário Mock", "Cinco APIs locais com health, métricas, caller/tenant validados e replay idempotente process-local nas operações mutáveis.")

System_Boundary(platform, "Plataforma de IA Conversacional — implementada") {
  Container(channelBff, "whatsapp-bff", ".NET 8", "Valida HMAC, persiste entrada no Kafka e deduplica respostas outbound no Redis.")
  Container(orchestrator, "conversation-orchestrator", ".NET 8", "Inbox, estado versionado por conversa, máquina de estados e Outbox transacional.")
  Container(agentRuntime, "agent-runtime-renegotiation", "Python / FastAPI / Strands", "Decisão estruturada e contexto assinado para tools.")
  Container(toolService, "tool-service-renegotiation", "Python / FastMCP", "Policy enforcement por estágio, confirmação e idempotência.")
  Container(renegotiation, "renegotiation-service", ".NET 8", "Defesa em profundidade e idempotência durável de simulação.")
  Container(agentRuntimeCartao, "agent-runtime-fatura-cartao", "Python / FastAPI / Strands", "Consulta de limite e fatura com guard determinístico de CPF.")
  Container(toolServiceCartao, "tool-service-cartao-credito", "Python / FastMCP", "Policy por serviço chamador e acesso direto à Card API mock.")
  Container(knowledge, "knowledge-service", "Python / FastAPI", "RAG em índice físico por tenant.")
  Container(memory, "conversation-memory-service", "Python / FastAPI", "Sessões Redis e histórico MongoDB tenant-scoped.")
  Container(audit, "conversation-audit-service", ".NET 8", "Auditoria idempotente por tenant.")
  Container(handoff, "conversation-handoff-service", ".NET 8", "Solicitações de handoff idempotentes.")

  ContainerDb(redis, "Redis", "Session/idempotency store", "Sessões e dedupe outbound.")
  ContainerDb(mongo, "MongoDB", "Document store", "Histórico e memória de longo prazo.")
  ContainerDb(postgres, "PostgreSQL", "Relational store", "Inbox, estado, Outbox, simulação, auditoria e handoff.")
  ContainerDb(opensearch, "OpenSearch", "Vector store", "Índice vetorial por tenant.")
  ContainerQueue(kafka, "Kafka", "Event streaming", "Entrada durável, retry, DLQ e eventos assíncronos.")
}

System_Boundary(observability, "Observabilidade local — implementada") {
  Container(alloy, "Grafana Alloy", "Collector", "Descobre containers pelo Docker socket e envia logs ao Loki.")
  Container(loki, "Loki", "Log store", "Armazena e consulta logs dos containers.")
  Container(jaeger, "Jaeger", "Trace backend", "Recebe traces OTLP e expõe consulta de spans.")
  Container(prometheus, "Prometheus", "Metrics + rules", "Coleta métricas e avalia regras versionadas.")
  Container(alertmanager, "Alertmanager", "Alert routing", "Agrupa e inibe alertas; receiver local nulo.")
  Container(grafana, "Grafana", "Visualization", "Dashboards e exploração de métricas, logs e traces.")
}

Rel(customer, whatsapp, "Envia/recebe mensagens", "WhatsApp")
Rel(whatsapp, channelBff, "Webhook assinado HMAC", "HTTPS")
Rel(channelBff, kafka, "Publica webhook bruto + traceparent", "Kafka")
Rel(kafka, channelBff, "Consome entrada/retry; poison → DLQ", "Kafka")
Rel(channelBff, orchestrator, "Mensagem normalizada", "HTTPS + JWT tenant_id")
Rel(orchestrator, postgres, "Inbox + estado + Outbox", "SQL")
Rel(orchestrator, agentRuntime, "Decisão de renegociação", "HTTP + JWT")
Rel(agentRuntime, openai, "Invoca modelo", "HTTPS")
Rel(agentRuntime, knowledge, "Busca RAG", "HTTP + JWT")
Rel(agentRuntime, toolService, "Contexto assinado", "MCP/HTTP")
Rel(toolService, renegotiation, "Policy proof + operação", "HTTP + JWT + Idempotency-Key")
Rel(renegotiation, coreMock, "Consulta/simula/formaliza", "HTTP + JWT + tenant + Idempotency-Key")
Rel(renegotiation, postgres, "Idempotência durável", "SQL")
Rel(orchestrator, agentRuntimeCartao, "Decisão da skill cartão", "HTTP + JWT")
Rel(agentRuntimeCartao, openai, "Invoca modelo", "HTTPS")
Rel(agentRuntimeCartao, toolServiceCartao, "Contexto assinado", "MCP/HTTP")
Rel(toolServiceCartao, coreMock, "Consulta limite/fatura", "HTTP + JWT + tenant")
Rel(orchestrator, memory, "Projeta sessão/histórico", "HTTP + JWT + Idempotency")
Rel(orchestrator, audit, "Grava auditoria", "HTTP + JWT + Idempotency-Key")
Rel(orchestrator, handoff, "Solicita handoff", "HTTP + JWT + Idempotency-Key")
Rel(orchestrator, channelBff, "Entrega resposta", "HTTP + JWT + Idempotency-Key")
Rel(channelBff, redis, "Dedupe outbound", "RESP")
Rel(memory, redis, "Sessões", "RESP")
Rel(memory, mongo, "Histórico/memória", "Mongo protocol")
Rel(knowledge, opensearch, "Embeddings/chunks", "HTTP")
Rel(orchestrator, kafka, "Eventos via Outbox", "Kafka")
Rel(agentRuntime, kafka, "agent.events", "Kafka")
Rel(toolService, kafka, "tool.executed", "Kafka")
Rel(agentRuntimeCartao, kafka, "agent.events", "Kafka")
Rel(toolServiceCartao, kafka, "tool.executed", "Kafka")
Rel(channelBff, whatsapp, "Envia resposta", "HTTPS")

Rel(alloy, channelBff, "Descobre e lê stdout; relação representa todos os containers", "Docker API")
Rel(alloy, loki, "Envia logs com labels de serviço", "Loki push API")
Rel(orchestrator, jaeger, "Exporta traces; relação representa serviços .NET", "OTLP gRPC")
Rel(agentRuntime, jaeger, "Exporta traces; relação representa serviços Python", "OTLP gRPC")
Rel(prometheus, jaeger, "Coleta métricas", "HTTP /metrics")
Rel(prometheus, alloy, "Coleta métricas internas", "HTTP /metrics")
Rel(prometheus, coreMock, "Coleta métricas do Core", "HTTP /metrics")
Rel(prometheus, channelBff, "Coleta endpoints de aplicação", "HTTP /metrics")
Rel(prometheus, alertmanager, "Envia alertas", "HTTP")
Rel(grafana, prometheus, "Consulta métricas", "PromQL")
Rel(grafana, loki, "Consulta logs", "LogQL")
Rel(grafana, jaeger, "Consulta traces", "HTTP")

SHOW_LEGEND()
@enduml
