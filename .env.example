# Copy to .env (same folder as docker-compose.yml) and fill in real values.
# .env is gitignored; this file documents what docker-compose.yml reads.

# --- Internal auth / multitenancy ---
# One secret per (issuer, audience) pair. Generate each value independently:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
INTERNAL_AUTH_SECRET_WHATSAPP_BFF__CONVERSATION_ORCHESTRATOR=
INTERNAL_AUTH_SECRET_CONVERSATION_ORCHESTRATOR__WHATSAPP_BFF=
INTERNAL_AUTH_SECRET_CONVERSATION_ORCHESTRATOR__AGENT_RUNTIME_RENEGOTIATION=
INTERNAL_AUTH_SECRET_CONVERSATION_ORCHESTRATOR__CONVERSATION_AUDIT_SERVICE=
INTERNAL_AUTH_SECRET_CONVERSATION_ORCHESTRATOR__CONVERSATION_HANDOFF_SERVICE=
INTERNAL_AUTH_SECRET_CONVERSATION_ORCHESTRATOR__CONVERSATION_MEMORY_SERVICE=
INTERNAL_AUTH_SECRET_AGENT_RUNTIME_RENEGOTIATION__TOOL_SERVICE_RENEGOTIATION=
INTERNAL_AUTH_SECRET_AGENT_RUNTIME_RENEGOTIATION__KNOWLEDGE_SERVICE=
INTERNAL_AUTH_SECRET_AGENT_RUNTIME_RENEGOTIATION__CONVERSATION_MEMORY_SERVICE=
INTERNAL_AUTH_SECRET_TOOL_SERVICE_RENEGOTIATION__RENEGOTIATION_SERVICE=
INTERNAL_AUTH_SECRET_RENEGOTIATION_SERVICE__CORE_BANCARIO_MOCK=
INTERNAL_AUTH_SECRET_AGENT_RUNTIME_FATURA_CARTAO__TOOL_SERVICE_CARTAO_CREDITO=
INTERNAL_AUTH_SECRET_CONVERSATION_ORCHESTRATOR__AGENT_RUNTIME_FATURA_CARTAO=
INTERNAL_AUTH_SECRET_TOOL_SERVICE_CARTAO_CREDITO__CORE_BANCARIO_MOCK=
DEFAULT_TENANT_ID=00000000-0000-0000-0000-000000000001

# --- WhatsApp Cloud API ---
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=local-dev-app-secret
WHATSAPP_VERIFY_TOKEN=local-dev-verify-token
WHATSAPP_GRAPH_API_VERSION=v20.0

# --- OpenAI ---
MOCK_AGENT_ENABLED=true
OPENAI_MODEL_ID=gpt-4o-mini-2024-07-18
OPENAI_API_KEY=

# --- Optional deployment overrides ---
KNOWLEDGE_SERVICE_BASE_URL=http://knowledge-service:8500
HANDOFF_SERVICE_BASE_URL=http://conversation-handoff-service:8080
